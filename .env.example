# ---- Backend ----
PORT=8787
HOST=0.0.0.0
NODE_ENV=development

# CORS (comma-separated origins). Use * only in dev.
CORS_ORIGINS=http://localhost:3000

# Public mainnet data sources (real). Pick any combination.
MEMPOOL_SPACE_API=https://mempool.space/api
ESPLORA_API=https://blockstream.info/api

# Optional self-hosted Bitcoin Core RPC (real full node). If set, the backend
# will prefer this for block / mempool / tx data over the public APIs.
BITCOIN_RPC_URL=
BITCOIN_RPC_USER=
BITCOIN_RPC_PASSWORD=

# Redis (optional — used for caching + rate limiting).
REDIS_URL=

# JWT secret (only used for authenticated /api/* endpoints; the explorer endpoints are public).
JWT_SECRET=change-me-in-production-please

# AES key (hex, 64 chars = 32 bytes). Used for at-rest encryption of any user-supplied secrets.
AES_KEY=

# ---- Pool dashboard (real pool APIs) ----
# These are NEVER hard-coded — the frontend asks the user for their own pool API key
# and posts it to the backend, which then proxies the real call. Set defaults here only
# if you want server-side dashboards.
BRAIINS_API_TOKEN=
ANTPOOL_API_KEY=
ANTPOOL_API_SECRET=
ANTPOOL_USER_ID=
F2POOL_USER=
VIABTC_API_KEY=
FOUNDRY_API_KEY=

# ---- Stratum proxy (real) ----
# Address the in-repo Stratum client connects to. By default points to a real public pool.
# Change to your own pool / your own ASIC if you self-host.
STRATUM_HOST=stratum.braiins.com
STRATUM_PORT=3333
STRATUM_USER=
STRATUM_PASSWORD=x

# ---- Frontend ----
NEXT_PUBLIC_BACKEND_URL=http://localhost:8787
NEXT_PUBLIC_MEMPOOL_API=https://mempool.space/api
NEXT_PUBLIC_MEMPOOL_WS=wss://mempool.space/api/v1/ws
NEXT_PUBLIC_NETWORK=mainnet
