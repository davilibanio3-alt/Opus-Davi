# ---- Backend ----
PORT=8787
HOST=0.0.0.0
NODE_ENV=development

# CORS (comma-separated origins). Use * only in dev.
CORS_ORIGINS=http://localhost:3000

# Public mainnet data sources (real). Pick any combination.
MEMPOOL_SPACE_API=https://mempool.space/api
ESPLORA_API=https://blockstream.info/api

# Optional self-hosted Bitcoin Core RPC (real full node). If set, the backend
# will prefer this for block / mempool / tx data over the public APIs.
BITCOIN_RPC_URL=
BITCOIN_RPC_USER=
BITCOIN_RPC_PASSWORD=

# Redis (optional — used for caching + rate limiting).
REDIS_URL=

# JWT secret (only used for authenticated /api/* endpoints; the explorer endpoints are public).
JWT_SECRET=change-me-in-production-please

# AES key (hex, 64 chars = 32 bytes). Used for at-rest encryption of any user-supplied secrets.
AES_KEY=

# ---- Pool dashboard (real pool APIs) ----
# These are NEVER hard-coded — the frontend asks the user for their own pool API key
# and posts it to the backend, which then proxies the real call. Set defaults here only
# if you want server-side dashboards.
BRAIINS_API_TOKEN=
ANTPOOL_API_KEY=
ANTPOOL_API_SECRET=
ANTPOOL_USER_ID=
F2POOL_USER=
VIABTC_API_KEY=
FOUNDRY_API_KEY=

# ---- Stratum proxy (real, external pools) ----
# Address the in-repo Stratum client connects to when probing a third-party pool.
STRATUM_HOST=stratum.braiins.com
STRATUM_PORT=3333
STRATUM_USER=
STRATUM_PASSWORD=x

# ---- Phase 2: self-hosted Bitcoin Core full node ----
# Used by docker-compose to authenticate the bitcoind container. The
# entrypoint renders an rpcauth= line at startup so the plaintext password
# never lives on disk.
BITCOIND_RPC_USER=opusrpc
BITCOIND_RPC_PASSWORD=
BTC_NETWORK=main

# ---- Phase 2: Stratum pool server ----
# This is YOUR mainnet payout address — any block the pool finds pays its
# subsidy + fees here. Set this to a wallet you control before starting.
POOL_PAYOUT_ADDRESS=
# Tag embedded in the coinbase scriptSig (visible in block explorers).
POOL_TAG=opus-davi
# Initial difficulty advertised to every new miner. 0.001 = roughly one share
# per minute on a 50 MH/s CPU. Bump for ASICs (e.g. 1024 for a TH/s-class miner).
POOL_INITIAL_DIFFICULTY=0.001
# Where the bitcoind RPC lives, from the pool's perspective. Inside the
# default docker-compose network this resolves to the bitcoind service.
BITCOIND_RPC_URL=http://bitcoind:8332

# ---- Phase 2: CPU miner sidecar (optional) ----
# Only used when you run docker compose with `--profile with-miner`.
MINER_WORKER=opus-davi.cpu
MINER_PASSWORD=x
MINER_THREADS=2

# ---- Phase 2: backend → pool stats bridge ----
# The backend periodically scrapes this URL to build the Pool dashboard.
POOL_STATS_URL=http://pool:3334/stats

# ---- Frontend ----
NEXT_PUBLIC_BACKEND_URL=http://localhost:8787
NEXT_PUBLIC_MEMPOOL_API=https://mempool.space/api
NEXT_PUBLIC_MEMPOOL_WS=wss://mempool.space/api/v1/ws
NEXT_PUBLIC_NETWORK=mainnet
